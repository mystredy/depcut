// Support tickets a signed-in user files (POST /api/support-tickets) and an
// admin triages from /admin/support (GET/PATCH /api/admin/support-tickets).
// No creator-facing "contact support" page exists yet to call the create
// endpoint from — the API is real and ready, just not linked from the UI.
// status: "Open" | "Investigating" | "Resolved".
model SupportTicket {
  id           String    @id @default(cuid())
  number       Int       @default(autoincrement())
  subject      String
  message      String
  status       String    @default("Open")
  userId       String
  user         User      @relation("SupportTicketRaisedBy", fields: [userId], references: [id], onDelete: Cascade)
  response     String?
  resolvedById String?
  resolvedBy   User?     @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("support_ticket")
}
