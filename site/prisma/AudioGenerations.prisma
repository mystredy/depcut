// A durable record of every Text to Speech render — split from Dubbing (see
// DubbingGenerations.prisma) so each tool owns its own table. Before this,
// the tool rendered its audio entirely client-side (see cut/lib/tts.ts) and
// only kept it in the browser's own local tool history, or in the user's
// Library if they explicitly clicked "Add to library." Only a SUCCESSFUL
// render is ever written — there is no in-progress or failed row, since the
// client already has the finished clip in hand before it calls the
// persistence endpoint (audioGenerations/db.ts's create). Media bytes live
// in R2 under this row's own outputKey (see cut/server/cloud/r2.ts's
// audioGenerationKey), same split as DubbingGeneration/FlowGeneration. A
// plain userId (better-auth id) with no FK keeps the table self-contained.
model AudioGeneration {
  id     String @id @default(cuid())
  userId String

  script    String
  direction String?
  voice     String
  language  String?

  outputKey       String
  outputMime      String
  durationSeconds Float?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
