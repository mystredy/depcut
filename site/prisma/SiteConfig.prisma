// Site-wide admin configuration: app identity, maintenance mode, and social
// platform OAuth credentials for the future publish pipeline (see
// Upload/Post in Marketplace.prisma).

// Singleton row (id is always "singleton"): every setting admin/settings/general
// exposes — site identity, localization, user access, legal links, and
// maintenance-mode copy. GET creates it on first read if missing. The public
// half of this row (everything but adminEmail and the raw image bytes) is
// served by /api/site/settings for signed-out surfaces — the marketing
// footer, the maintenance gate, the theme default; see that route for
// exactly which fields it omits and why.
model AppSettings {
  id                   String   @id @default("singleton")
  appName              String   @default("DepCut")
  tagline              String?
  description          String?
  websiteUrl           String?
  // Shown to visitors (the footer, a "need help" link). adminEmail below is
  // the operator's own notification address and never rendered publicly.
  supportEmail         String?
  contactEmail         String?
  adminEmail           String?
  defaultLocale        String   @default("en-US")
  timezone             String   @default("UTC")
  // date-fns-style tokens ("MM/DD/YYYY", "DD/MM/YYYY", "YYYY-MM-DD", …) and
  // "12h" | "24h" — read by src/lib/siteDateFormat.ts.
  dateFormat           String   @default("MM/DD/YYYY")
  timeFormat           String   @default("12h")
  // "light" | "dark" | "system" — the theme a visitor with no stored
  // preference of their own gets; see ThemeScript.tsx.
  defaultTheme         String   @default("system")
  // Hex, e.g. "#7C5CFA" — overrides --primary site-wide; see app/layout.tsx.
  accentColor          String?
  copyrightText        String?
  footerText           String?
  maintenanceMode      Boolean  @default(false)
  maintenanceHeader    String?
  maintenanceParagraph String?
  maintenanceFooter    String?
  // Gates new-account creation on sign-in (auth.ts's databaseHooks.user.create.before)
  // without touching an existing account's ability to keep signing in.
  allowRegistration    Boolean  @default(true)
  // Stored for when email/password sign-in exists — every account today
  // signs in with Google, which better-auth already treats as verified, so
  // this has nothing to gate yet (see auth.ts).
  requireEmailVerification Boolean @default(false)
  // Stored for when a role system exists — nothing in this codebase branches
  // on a user role yet (only the superUser flag on User).
  defaultUserRole      String   @default("User")
  termsUrl             String?
  privacyUrl           String?
  cookiePolicyUrl      String?
  helpCenterUrl        String?
  // { youtube?, tiktok?, instagram?, x?, discord?: string }, each a full URL.
  socialLinks          Json?
  // Shows a Beta badge beside the logo and an optional notice; see BetaBadge.tsx.
  betaMode             Boolean  @default(false)
  // Site branding, uploaded from admin/settings/general. The favicon and apple
  // touch icon back the /icon and /apple-icon routes (site/src/app/icon.tsx
  // and apple-icon.tsx) independently — one is not derived from the other.
  // The social share image feeds the root layout's Open Graph/Twitter meta.
  //
  // All six *Bytes columns below are unused — every branding image now lives
  // in R2 instead (site-branding/logo-<theme>, favicon, apple-touch-icon,
  // social-share-image — see cut/server/cloud/r2.ts's key helpers and the
  // site logo route / branding-image route / _icon-source.ts / _social-image
  // .tsx that read them), since an image painted on every surface shouldn't
  // depend on a live DB read. Left in place rather than migrated out; safe to
  // drop in a future schema change.
  logoLight            Bytes?
  logoLightContentType String?
  logoDark             Bytes?
  logoDarkContentType  String?
  logoCompact               Bytes?
  logoCompactContentType    String?
  favicon              Bytes?
  faviconContentType   String?
  appleTouchIcon            Bytes?
  appleTouchIconContentType String?
  socialShareImage          Bytes?
  socialShareImageContentType String?
  updatedAt            DateTime @updatedAt

  @@map("app_settings")
}

// A named group of SocialConnections. Posting to a brand is meant to fan
// out to every connection in it — that publish pipeline doesn't exist yet,
// this is just the grouping.
model Brand {
  id              String             @id @default(cuid())
  name            String             @unique
  username        String             @unique
  logo            Bytes?
  logoContentType String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  connections SocialConnection[]

  @@map("brand")
}

// An individual linked social/storage account available as a publish source
// or destination — e.g. "Virals Facebook @Tobiloba Mohammed", distinct from
// SocialAppConfig's per-platform API app credentials. No OAuth handshake
// exists to create these automatically — admins record connections here
// after linking an account out-of-band, and mark them inactive when a
// token expires. role: "source" | "destination".
model SocialConnection {
  id             String    @id @default(cuid())
  platform       String
  accountName    String
  accountHandle  String?
  role           String    @default("destination")
  status         String    @default("active")
  // Write-only from the admin API, same redaction rule as everywhere else
  // credentials are stored — reads only ever say whether a token is set.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sourceOf       SocialWorkflow[] @relation("WorkflowSource")
  destinationOf  SocialWorkflow[] @relation("WorkflowDestination")

  @@index([platform])
  @@index([brandId])
  @@map("social_connection")
}

// Pairs a source SocialConnection with a destination one for repurposing
// content between platforms. No real publish pipeline reads this yet —
// autoPublish is a stored admin preference, not live automation.
// status: "Active" | "Inactive".
model SocialWorkflow {
  id                    String           @id @default(cuid())
  name                  String
  sourceConnectionId    String
  sourceConnection      SocialConnection @relation("WorkflowSource", fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  destinationConnectionId String
  destinationConnection SocialConnection @relation("WorkflowDestination", fields: [destinationConnectionId], references: [id], onDelete: Cascade)
  status                String           @default("Active")
  autoPublish           Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([sourceConnectionId])
  @@index([destinationConnectionId])
  @@map("social_workflow")
}

model SocialAppConfig {
  id          String   @id @default(cuid())
  platform    String   @unique
  enabled     Boolean  @default(false)
  credentials Json?
  updatedAt   DateTime @updatedAt

  @@map("social_app_config")
}

// Singleton row (id is always "singleton"): which admin events push a
// message to the Telegram bot's destinations. The destinations themselves
// (admin, group, channel) live on SocialAppConfig instead (platform
// "telegram", adminId/groupId/channelId) alongside the bot's other identity
// fields — this row is just the event toggles. Read by notifyTelegram
// (src/lib/telegram/notify.ts), which every trigger point calls
// best-effort — a notification failure never blocks the real action.
model TelegramNotificationSettings {
  id                   String   @id @default("singleton")
  notifySubmissions    Boolean  @default(false)
  notifyWithdrawals    Boolean  @default(false)
  notifySupportTickets Boolean  @default(false)
  notifySignups        Boolean  @default(false)
  notifySystemErrors   Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("telegram_notification_settings")
}
