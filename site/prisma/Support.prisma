// Support tickets a signed-in user files, from the "Give feedback" account
// menu item (POST /api/support-tickets), and an admin triages from
// /admin/support (GET/PATCH /api/admin/support-tickets).
// status: "Open" | "Investigating" | "Resolved".
model SupportTicket {
  id                    String    @id @default(cuid())
  number                Int       @default(autoincrement())
  subject               String
  message               String
  status                String    @default("Open")
  userId                String
  user                  User      @relation("SupportTicketRaisedBy", fields: [userId], references: [id], onDelete: Cascade)
  response              String?
  resolvedById          String?
  resolvedBy            User?     @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt            DateTime?
  // An optional screenshot attached at submission — same inline-bytes
  // pattern as UserAvatar, sized for a screenshot rather than a photo.
  attachmentData        Bytes?
  attachmentContentType String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@map("support_ticket")
}
