// Support tickets a signed-in user files, from the "Give feedback" account
// menu item (POST /api/support-tickets), and an admin triages from
// /admin/support (GET/PATCH /api/admin/support-tickets). Threaded: a ticket
// holds many messages — the raiser's opening message plus every admin
// reply — instead of squeezing the whole exchange into a single
// message/response pair, so a ticket can go back and forth more than once.
// status: "Open" | "Investigating" | "Answered" | "Closed".
// priority: "Low" | "Medium" | "High".
model SupportTicket {
  id          String           @id @default(cuid())
  number      Int              @default(autoincrement())
  subject     String
  status      String           @default("Open")
  priority    String           @default("Low")
  userId      String
  user        User             @relation("SupportTicketRaisedBy", fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  // Set whenever a new message lands. Null until the first reply.
  lastReplyAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@map("support_ticket")
}

// One message in a ticket's thread: the raiser's opening message (authorId
// is the ticket's own raiser) or an admin's reply (authorId is whichever
// super user sent it).
model SupportMessage {
  id          String                     @id @default(cuid())
  ticketId    String
  ticket      SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                       @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  message     String
  // Up to 7 screenshots — see SupportMessageAttachment.
  attachments SupportMessageAttachment[]
  createdAt   DateTime                   @default(now())

  @@index([ticketId])
  @@map("support_message")
}

// One screenshot attached to a message — same inline-bytes pattern as
// UserAvatar, sized for a screenshot rather than a photo. Served by
// /api/admin/support-tickets/attachment/[attachmentId].
model SupportMessageAttachment {
  id          String         @id @default(cuid())
  messageId   String
  message     SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  createdAt   DateTime       @default(now())

  @@index([messageId])
  @@map("support_message_attachment")
}
