// The creator "Rates" economy: per-creator balances, withdrawal requests,
// the platform exchange rate, and the ledger of every balance-affecting
// event. Distinct from Credits.prisma's UserCreditAccount, which is the
// Stripe-billed AI inference credit system — these Rates are what a creator
// earns and cashes out, not what they spend on AI tools.
//
// Two separate wallets, deliberately not one:
//  - ArtistRateAccount ("Artist Earnings", shown on /app/artist/my-projects
//    only): what submissions earn, denominated in Rates. Approving a
//    Submission (api/admin/submissions/[id]) credits `pending` and
//    `lifetime` immediately and logs a "Pending" FinanceTransaction of type
//    "Earning". artistRatesSweep.ts (the bi-weekly job behind
//    /api/finance/rates-sweep/run, on the 1st and 16th) moves that
//    half-month's earnings from `pending` into `available` once its cycle
//    completes. Nothing here is ever directly withdrawable.
//  - PayoutAccount ("Payout", shown on /app/settings/payouts): a separate
//    balance, denominated in USD. The creator moves Rates out of their
//    ArtistRateAccount.available into here explicitly (see
//    api/artist/rates/move-to-payout), converting at that moment's
//    FinanceExchangeRate — the only place that conversion happens. Only
//    PayoutAccount.available is ever drawn down by a real Withdrawal.
//
// Anything else touching a balance is still a manual admin action from
// /admin/finance, logged the same way.

// One row per creator with a Rates balance. Created lazily (upsert) the
// first time a submission earns Rates or an admin adjusts a balance.
model ArtistRateAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Earned but not yet cash-out eligible — waiting on artistRatesSweep.ts to
  // clear its earn window's cycle.
  pending   Int      @default(0)
  // Cleared the sweep; eligible to move to PayoutAccount, not itself
  // withdrawable.
  available Int      @default(0)
  referral  Int      @default(0)
  // Total ever earned, counted at earn time — never decremented by the
  // pending -> available sweep or by a move to payout.
  lifetime  Int      @default(0)
  // "Standard" | "Pro" — set by an admin (see /admin/finance/rates). Not
  // read by anything yet; a place to hang a future Pro-only capability.
  tier      String   @default("Standard")
  // False after an admin revokes artist access (see isDepCutArtist) — the
  // row itself stays so Artist Rates can still show a former artist and
  // their balance history, and re-granting reactivates it rather than
  // starting a fresh row.
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("artist_rate_account")
}

// One row per creator with a Payout (USD) balance. Created lazily the first
// time Rates are moved in from an ArtistRateAccount, or an admin adjusts a
// balance directly. Not artist-specific — any earning program (DepArtist
// today, Affiliate potentially later) can credit it the same way.
model PayoutAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cash-out eligible; what a Withdrawal actually draws down.
  available Float    @default(0)
  // Total ever moved into this wallet — never decremented by a withdrawal.
  lifetime  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@map("payout_account")
}

// A creator cashout request against their available Payout (USD) balance.
// status: "Pending" | "Approved" | "Paid" | "Rejected".
model Withdrawal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountRequested  Int
  processingFee    Float
  finalAmount      Float
  method           String
  destination      String
  exchangeRateUsed Float
  status           String   @default("Pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("withdrawal")
}

// An append-only log of every balance-affecting finance event (manual
// adjustments, paid withdrawals, settled giveaway/referral payouts).
// type: "Withdrawal" | "Referral" | "Giveaway" | "Manual Adjustment".
model FinanceTransaction {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String
  type        String
  ratesAmount Int      @default(0)
  amount      Float    @default(0)
  status      String   @default("Completed")
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@map("finance_transaction")
}

// Singleton row (id always "singleton"). GET creates it on first read.
model FinanceSettings {
  id                String   @id @default("singleton")
  minWithdrawal     Int      @default(500)
  processingFeePct  Float    @default(2.5)
  taxPct            Float    @default(0)
  currency          String   @default("USD")
  paymentWindow     String   @default("3-5 business days")
  payoutCycle       String   @default("Bi-monthly (1st & 16th)")
  autoTransferDates String   @default("1st, 16th")
  methodBank        Boolean  @default(true)
  methodTonWallet   Boolean  @default(false)
  methodStars       Boolean  @default(false)
  methodCrypto      Boolean  @default(false)
  // Rates paid to an affiliate for every qualified new signup through their
  // referral link. See Affiliate.prisma.
  affiliateCommissionRates Int @default(100)
  updatedAt         DateTime @updatedAt

  @@map("finance_settings")
}

// Singleton row (id always "singleton") holding the live 1-Rate-to-USD
// conversion. Every change is also appended to FinanceExchangeRateHistory.
model FinanceExchangeRate {
  id            String   @id @default("singleton")
  currentRate   Float    @default(0.01)
  effectiveDate String   @default("")
  updatedAt     DateTime @updatedAt

  @@map("finance_exchange_rate")
}

model FinanceExchangeRateHistory {
  id            String   @id @default(cuid())
  rate          Float
  effectiveDate String
  authorName    String
  createdAt     DateTime @default(now())

  @@map("finance_exchange_rate_history")
}

// A manually-recorded giveaway prize payout. No live giveaway/leaderboard
// system exists yet — admins record winners and mark them paid here.
// status: "Pending" | "Paid" | "Rejected".
model GiveawayPayment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topPosition String
  reward      String
  status      String    @default("Pending")
  paidBy      String?
  paidDate    DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("giveaway_payment")
}

// One row per creator with referral commissions. No referral-tracking
// system exists yet (User has no referredBy relation) — admins record
// referral counts and commissions manually and settle them here.
model ReferralCommission {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCount    Int      @default(0)
  commissionEarned Float    @default(0)
  commissionPaid   Float    @default(0)
  activeReferrals  Int      @default(0)
  expiredReferrals Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("referral_commission")
}
