// My Space: each account's personal post feed (see /app/space and the
// editor's "Post to Space" action). Deliberately its own, simple model
// rather than reusing Marketplace.prisma's Submission/SubmissionAsset —
// those carry a whole paid-task review state machine (category, points,
// reward, status remarks) that a casual post has no business dragging
// along. One row per post; a post has at most one video, so there's no
// separate per-asset table the way a submission's video/thumbnail/
// verification trio needs.
//
// projectId is intentionally a plain field, not a relation: a local
// (Mac-app-resident) project has no CutProject row at all, so an FK
// constraint would break the common case. It's a label, not a join target.
model SpacePost {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null posts to the author's own personal Space (the default, and the
  // only option before Brand Spaces existed); set posts to that Brand
  // Space's feed instead — the author is still whichever manager posted it.
  brandSpaceId String?
  brandSpace   BrandSpace? @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  projectId    String?
  caption      String?
  // Original picked filename, kept as a label.
  fileName     String?
  // R2 object keys — see src/cut/server/cloud/r2.ts's spacePostVideoKey /
  // spacePostThumbnailKey. Set as soon as a PUT is presigned; status is what
  // tracks whether the bytes actually arrived.
  storageKey   String?
  thumbnailKey String?
  // Authoritative byte size, filled in from R2's own HEAD response once the
  // upload is verified — never trusted from the client. What the 10GB
  // per-account quota (lib/space/storage.ts) sums over.
  sizeBytes    Int?
  status       String   @default("pending")
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([brandSpaceId])
  @@map("space_post")
}
