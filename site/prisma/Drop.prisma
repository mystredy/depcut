// A post to a studio's feed — DepCut's publishing type, the equivalent of a
// YouTube Short or a TikTok Post (see the editor's "Post to Space" action
// and a studio's own page). Deliberately its own, simple model rather than
// reusing Marketplace.prisma's Submission/SubmissionAsset — those carry a
// whole paid-task review state machine (category, points, reward, status
// remarks) that a casual drop has no business dragging along. One row per
// drop; a drop has at most one video, so there's no separate per-asset
// table the way a submission's video/thumbnail/verification trio needs.
//
// projectId is intentionally a plain field, not a relation: a local
// (Mac-app-resident) project has no CutProject row at all, so an FK
// constraint would break the common case. It's a label, not a join target.
//
// Mapped table is "drop", singular like every other table here — DROP is a
// SQL keyword, but Prisma always double-quotes identifiers in generated
// SQL, so this is safe as long as any hand-written SQL against it does too.
model Drop {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Every drop belongs to a real studio — the author is still whichever
  // manager posted it, but there's no implicit "my own default" one.
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  projectId    String?
  // Short headline shown above the description, same role as a YouTube
  // Short's title. Optional — a caption-only drop is still a valid post.
  title        String?
  caption      String?
  // Free-form keywords the author typed in, stored without their leading
  // "#" (added back for display) so a search can match "dance" whether the
  // author wrote "#dance" or "dance".
  hashtags     String[] @default([])
  // Original picked filename, kept as a label.
  fileName     String?
  // R2 object keys — see src/cut/server/cloud/r2.ts's spacePostVideoKey /
  // spacePostThumbnailKey. Set as soon as a PUT is presigned; status is what
  // tracks whether the bytes actually arrived.
  storageKey   String?
  thumbnailKey String?
  // Authoritative byte size, filled in from R2's own HEAD response once the
  // upload is verified — never trusted from the client. What the 10GB
  // per-account quota (lib/studio/storage.ts) sums over.
  sizeBytes    Int?
  // "pending" -> "uploading" -> "draft" -> "complete" (posted), or
  // "draft" -> "scheduled" -> "complete" once the scheduled sweep runs (see
  // src/lib/jobs/dropScheduleSweep.ts). "error" on an upload failure.
  status       String   @default("pending")
  // Who can see a "complete" drop on the studio's profile grid — "public"
  // (the default; anyone signed in), "unlisted" (excluded from the grid but
  // resolvable by a direct link, any signed-in account), or "private"
  // (studio managers only). Meaningless before "complete": a draft or
  // scheduled drop is already manager-only regardless of this field.
  visibility   String   @default("public")
  // Set when a manager schedules a post instead of publishing immediately —
  // the sweep publishes it once this time has passed. Left in place after
  // publishing as a record of when it was scheduled for; null for a drop
  // that was always published immediately.
  scheduledFor DateTime?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publications DropPublication[]
  // Set only for a Drop created by social-workflow-import.ts instead of a
  // real upload — the source platform + its post id, so a re-run of the
  // import sweep can tell it's already been pulled in and skip it.
  importedPlatform   String?
  importedExternalId String?

  @@index([userId])
  @@index([status])
  @@index([studioId])
  @@index([studioId, importedPlatform, importedExternalId])
  // The scheduled-drop sweep's own lookup (src/lib/jobs/dropScheduleSweep.ts).
  @@index([status, scheduledFor])
  @@map("drop")
}

// One row per attempt to push a Drop to a destination — written by
// publishDropToConnection (dropPublish.ts) right after it calls
// publishToConnection. The durable record of what happened, including the
// platform's own post id, since the AsyncJob row an automated publish ran
// under isn't meant to be queried as history. destinationConnectionId is a
// plain field, not a relation, so this row survives the connection being
// removed or reconnected — the platform/account name here are copied at
// publish time for exactly that reason. workflowId is null for a manual
// one-off repurpose (see /api/studios/[id]/drops/[dropId]/repurpose),
// which has no SocialWorkflow behind it.
model DropPublication {
  id                      String   @id @default(cuid())
  dropId                  String
  drop                    Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  workflowId              String?
  destinationConnectionId String
  platform                String
  destinationAccountName  String
  status                  String // "success" | "failed"
  externalPostId          String?
  externalUrl             String?
  error                   String?
  createdAt               DateTime @default(now())

  @@index([dropId])
  @@index([destinationConnectionId])
  @@map("drop_publication")
}
