// The public marketing blog (depcut.app/blog). Every post lives here whether
// it's published yet or not — a draft is just a row with published: false,
// filtered out of the public list and detail routes. Content is Markdown,
// rendered with react-markdown the same way the legal pages are (see
// lib/pages/legal-pages.ts). The cover image rides in R2, not this table —
// same split as the site logo (cut/server/cloud/r2.ts's blogCoverKey) — this
// row only ever needs to know whether one exists.
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  contentMarkdown String
  authorName    String?
  // Deprecated, superseded by tags below — kept only so the one-time backfill
  // script can still read old single-tag rows through the Prisma client.
  // Stop writing to this field; drop the column once tags is confirmed to
  // hold every row's data.
  tag           String?
  // Free-text labels a post can carry, shown as clickable chips on /blog and
  // /blog/[slug] that link to /blog/category/[slug]. A category has no row of
  // its own — its slug is derived from the label (see lib/blog/categories.ts)
  // and a category page just filters published posts whose tags match it.
  tags          String[]  @default([])
  hasCoverImage Boolean   @default(false)
  published     Boolean   @default(false)
  publishedAt   DateTime?
  // Whichever admin's account created this row — shown as an avatar in the
  // admin list. Separate from authorName, which is the public byline and can
  // read as anything ("DepCut Team", a pen name) regardless of who wrote it.
  createdByUserId String?
  createdBy       User?   @relation("BlogPostCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}
