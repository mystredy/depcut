// Support tickets a signed-in user files, from the "Give feedback" account
// menu item (POST /api/support-tickets), and an admin triages from
// /admin/support (GET/PATCH /api/admin/support-tickets).
// status: "Open" | "Investigating" | "Resolved".
model SupportTicket {
  id           String                    @id @default(cuid())
  number       Int                       @default(autoincrement())
  subject      String
  message      String
  status       String                    @default("Open")
  userId       String
  user         User                      @relation("SupportTicketRaisedBy", fields: [userId], references: [id], onDelete: Cascade)
  response     String?
  resolvedById String?
  resolvedBy   User?                     @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  // Up to 7 screenshots attached at submission — see SupportTicketAttachment.
  attachments  SupportTicketAttachment[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([status])
  @@map("support_ticket")
}

// One screenshot attached to a ticket at submission — same inline-bytes
// pattern as UserAvatar, sized for a screenshot rather than a photo. Served
// by /api/admin/support-tickets/attachment/[attachmentId].
model SupportTicketAttachment {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ticket_attachment")
}
