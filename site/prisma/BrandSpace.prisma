// Brand Spaces: an account can create one or more of these in addition to
// their own personal Space (Space.prisma) — the Page-to-Profile
// relationship on Facebook. Each has its own managers (BrandSpaceMember),
// public profile, publicly-displayed linked-account handles, connected
// publish destinations (SocialConnection.brandSpaceId), and post feed
// (SpacePost.brandSpaceId).
model BrandSpace {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique
  bio                String?
  avatarImageKey     String?
  backgroundImageKey String?
  // "Creator" today — a plain string, not an enum, so a new type doesn't
  // need a migration.
  spaceType          String   @default("Creator")
  ownerId            String
  owner              User     @relation("BrandSpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // { facebook?: "handle", instagram?: "handle", ... } — public display text
  // only, no token. Distinct from `connections`, which are real
  // OAuth-backed publish destinations.
  linkedAccounts     Json?
  members            BrandSpaceMember[]
  invites            BrandSpaceInvite[]
  activity           BrandSpaceActivity[]
  connections        SocialConnection[]
  posts              SpacePost[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId])
  @@map("brand_space")
}

// Who can manage a Brand Space. The owner also gets a row here (role
// "owner", created alongside the space) so member lists and permission
// checks never special-case the owner separately. role: "owner" | "manager".
model BrandSpaceMember {
  id           String     @id @default(cuid())
  brandSpaceId String
  brandSpace   BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("manager")
  createdAt    DateTime   @default(now())

  @@unique([brandSpaceId, userId])
  @@index([userId])
  @@map("brand_space_member")
}

// A pending invite to manage a Brand Space, sent to an email address that
// may or may not have a DepCut account yet. Redeemed into a
// BrandSpaceMember row when the invited email accepts.
// status: "Pending" | "Accepted" | "Revoked".
model BrandSpaceInvite {
  id           String     @id @default(cuid())
  brandSpaceId String
  brandSpace   BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  email        String
  role         String     @default("manager")
  invitedById  String
  invitedBy    User       @relation("BrandSpaceInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  token        String     @unique
  status       String     @default("Pending")
  createdAt    DateTime   @default(now())

  @@index([brandSpaceId])
  @@index([email])
  @@map("brand_space_invite")
}

// The management-action history shown on a Brand Space's settings — who
// did what, when. Written alongside every mutation the Brand Space routes
// make (invited, removed, role changed, renamed, connection added/removed).
model BrandSpaceActivity {
  id           String     @id @default(cuid())
  brandSpaceId String
  brandSpace   BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  detail       String?
  createdAt    DateTime   @default(now())

  @@index([brandSpaceId])
  @@map("brand_space_activity")
}
