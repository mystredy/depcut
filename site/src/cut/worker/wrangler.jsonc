// Cloudflare deployment for the Cut render worker: one Worker (cf/worker.ts)
// owning one container instance built from ./Dockerfile. Deploy from site/:
//   npm run worker:build && npx wrangler deploy -c src/cut/worker/wrangler.jsonc
// Secrets (DATABASE_URL, R2_*) are set once with `wrangler secret put`, never
// checked in.
{
  "name": "depcut-worker",
  "main": "cf/worker.ts",
  "compatibility_date": "2026-07-01",
  // Streams the container's stdout/stderr into Workers Logs (wrangler tail).
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "CutRenderWorker",
      "image": "./Dockerfile",
      // The Dockerfile copies dist/cut-worker/main.js, so the build context is
      // the site root (three levels up from this file).
      "image_build_context": "../../..",
      // Renders scale out, not up: each replica runs ONE job on the whole box
      // (MAX_RUNNING in ../main.ts), so an export never splits cores with
      // another render or queues behind someone else's. Keep this in step with
      // REPLICAS in cf/worker.ts — that constant is what /wake starts.
      "max_instances": 4,
      // The platform maximum (4 vCPU / 12 GiB / 20 GB). ffmpeg encodes are
      // CPU-bound and x264 scales nearly linearly across threads, and container
      // CPU bills on active use rather than provisioned, so the wider box costs
      // about the same per render and finishes in half the time. Cloudflare
      // validation: >= 3 GiB memory per vCPU, disk <= 2x memory.
      "instance_type": { "vcpu": 4, "memory_mib": 12288, "disk_mb": 20000 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CUT_RENDER_WORKER", "class_name": "CutRenderWorker" }]
  },
  // Shared media is served from the edge (cf/media.ts) with the bucket kept
  // private: this binding is the only way in. The Cache API is inert on
  // workers.dev, so a deployment without a zone of its own (no custom domain
  // yet) loses edge caching until it moves onto one — cf/worker.ts routes by
  // path in that case, so media still serves correctly, just uncached.
  "r2_buckets": [{ "binding": "CUT_MEDIA", "bucket_name": "deepw-media" }],
  // No custom domain yet: publish to <name>.<account>.workers.dev instead.
  // Once you own a zone, add a "routes" array back (two custom_domain
  // patterns, named in ../../lib/hosts.ts as CUT_MEDIA_HOST/CUT_WORKER_HOST)
  // and set this back to false — declaring a route flips wrangler's default
  // for this flag, so it has to be explicit either way.
  "workers_dev": true,
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CutRenderWorker"] }],
  // Share-copy jobs drain serially: one message per batch, one batch in
  // flight, so a burst of copy requests can't stampede R2 or the database.
  // Create the queue once: npx wrangler queues create depcut-copy
  "queues": {
    "consumers": [
      {
        "queue": "depcut-copy",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  }
}
