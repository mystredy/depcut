// The Telegram bot's real, running behavior — distinct from
// SocialAppConfig's credentials (how to authenticate) and
// TelegramNotificationSettings (outbound admin alerts). The webhook at
// /api/telegram/webhook matches an incoming message's first word against
// `trigger` and replies with `replyText`.
model TelegramCommand {
  id        String   @id @default(cuid())
  trigger   String   @unique
  replyText String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_command")
}

// One row per distinct Telegram chat that has ever messaged the bot —
// recorded by the webhook on every update. The only real source for a
// "how many users" count; nothing here is estimated or seeded.
model TelegramBotUser {
  chatId    String   @id
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@map("telegram_bot_user")
}

// Single-use, short-lived credential for the Preferences page's "Link bot"
// flow: issued to a signed-in user as both a `?start=` deep-link token and a
// human-typeable 6-digit pin (for when the deep link doesn't open Telegram
// cleanly — no app installed, wrong device). Either redeems the same row via
// the webhook's handler (commands.ts), which sets User.telegramChatId and
// deletes it. A row older than 15 minutes is treated as expired.
model TelegramLinkToken {
  token     String   @id @default(cuid())
  pin       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
